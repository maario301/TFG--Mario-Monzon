<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardPanico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#E53935"
            android:layout_marginBottom="25dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🆘 EMERGENCIA 112"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:padding="20dp"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="25dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consejo de Prevención"
                    android:textColor="#1976D2"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtConsejoCuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando..."
                    android:textColor="#555555"
                    android:layout_marginTop="5dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Primeros Auxilios Rápidos"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <FrameLayout
            android:id="@+id/containerSerpiente"
            android:layout_width="match_parent"
            android:layout_height="180dp"> <androidx.cardview.widget.CardView
            android:id="@+id/cardBackSerpiente"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="15dp"
            app:cardBackgroundColor="#FFF3E0"
            android:alpha="0">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="SERPIENTES:\n1. Inmovilizar.\n2. NO succionar.\n3. Quitar joyas."
                android:gravity="center"
                android:padding="15dp"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#E65100"/>
        </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardFrontSerpiente"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="15dp"
                app:cardBackgroundColor="#43A047">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="SÍNTOMAS DE MORDEDURA\n(Toca para ver consejos)"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:padding="10dp" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/containerArana"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="15dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBackArana"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="15dp"
                app:cardBackgroundColor="#E1F5FE"
                android:alpha="0">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="ARÁCNIDOS:\n1. Lavar con agua y jabón.\n2. Aplicar frío local.\n3. No succionar ni cortar."
                    android:gravity="center"
                    android:padding="15dp"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#0288D1" />
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFrontArana"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="15dp"
                app:cardBackgroundColor="#03A9F4">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="PICASURAS DE ARAÑA\nO ESCORPIÓN"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/containerAvispa"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="20dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/cardBackAvispa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="15dp"
                app:cardBackgroundColor="#FFFDE7"
                android:alpha="0">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="INSECTOS:\n1. Retirar aguijón (raspando).\n2. Lavar zona.\n3. Vigilar alergias (112)."
                    android:gravity="center"
                    android:padding="15dp"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#FBC02D" />
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFrontAvispa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="15dp"
                app:cardBackgroundColor="#FDD835">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="PICADURAS DE AVISPA\nO ABEJA"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

    </LinearLayout>
</ScrollView>