<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardPanico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#E53935"
            android:layout_marginBottom="25dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🆘 EMERGENCIA 112"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:padding="20dp"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="25dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Estadísticas de avistamientos"
                    android:textColor="#2D6A2D"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/txtStatTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="–"
                            android:textColor="#2D6A2D"
                            android:textSize="30sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Avistamientos"
                            android:textColor="#777777"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/txtStatEspecies"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="–"
                            android:textColor="#2D6A2D"
                            android:textSize="30sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Especies"
                            android:textColor="#777777"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtStatUltimo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando estadísticas..."
                    android:textColor="#444444"
                    android:textSize="14sp"
                    android:layout_marginTop="14dp"
                    android:gravity="center" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="25dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 Recomendaciones de Seguridad"
                    android:textColor="#1976D2"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/txtConsejoCuerpo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando consejos técnicos..."
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="15dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="25dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgAnimalDia"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/serpiente" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🦂 Animal del día"
                        android:textColor="#2D6A2D"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtNombreDia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#222222"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/txtCientificoDia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#888888"
                        android:textStyle="italic"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtToxicidadDia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toxicidad: —"
                        android:textColor="#E53935"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/txtDescripcionDia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#444444"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/txtHabitatDia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#444444"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/txtSintomasDia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#444444"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/txtTratamientoDia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#444444"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/txtCuriosidadDia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#1976D2"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="12dp"
                        android:background="#F0F6FF"
                        android:padding="10dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guía de Primeros Auxilios"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <FrameLayout android:id="@+id/containerSerpiente" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginBottom="16dp">
            <include layout="@layout/item_card_back" android:id="@+id/layoutBackSerpiente" />
            <androidx.cardview.widget.CardView android:id="@+id/cardFrontSerpiente" android:layout_width="match_parent" android:layout_height="match_parent" app:cardCornerRadius="15dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <ImageView android:id="@+id/imgSerpiente" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/serpiente" />
                    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#66000000" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OFIDIOS\n(Serpientes)" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="22sp" android:layout_centerInParent="true" android:gravity="center"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <FrameLayout android:id="@+id/containerArana" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginBottom="16dp">
            <include layout="@layout/item_card_back" android:id="@+id/layoutBackArana" />
            <androidx.cardview.widget.CardView android:id="@+id/cardFrontArana" android:layout_width="match_parent" android:layout_height="match_parent" app:cardCornerRadius="15dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <ImageView android:id="@+id/imgArana" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/arana" />
                    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#66000000" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ARÁCNIDOS\n(Arañas y Escorpiones)" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="22sp" android:layout_centerInParent="true" android:gravity="center"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <FrameLayout android:id="@+id/containerAvispa" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginBottom="20dp">
            <include layout="@layout/item_card_back" android:id="@+id/layoutBackAvispa" />
            <androidx.cardview.widget.CardView android:id="@+id/cardFrontAvispa" android:layout_width="match_parent" android:layout_height="match_parent" app:cardCornerRadius="15dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <ImageView android:id="@+id/imgAvispa" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/abeja" />
                    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#66000000" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HIMENÓPTEROS\n(Abejas y Avispas)" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="22sp" android:layout_centerInParent="true" android:gravity="center"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </FrameLayout>

    </LinearLayout>
</ScrollView>