<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/txtTituloMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mapa de Avistamientos"
        android:background="#80000000"
        android:textColor="#FFFFFF"
        android:padding="10dp"
        android:textAlignment="center"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtInstruccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtTituloMapa"
        android:text="Toca el mapa para marcar dónde viste al animal (puedes arrastrar el marcador)"
        android:background="#CC1976D2"
        android:textColor="#FFFFFF"
        android:padding="8dp"
        android:textAlignment="center"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnConfirmarUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_margin="24dp"
        android:text="Confirmar ubicación"
        android:visibility="gone" />

</RelativeLayout>
